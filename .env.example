# 「未然」运行配置模板
#
# 用法：复制为 .env 并填入真实值。
#   cp .env.example .env
#
# ⚠️ .env 已在 .gitignore 中，**绝不入库**。
#    提交前自检：git status 里不应出现 .env。

# ---- 对话模型（OpenAI 兼容端点）----
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL_NAME=

# 推理开关。部分模型（如 DeepSeek 系）默认开启推理，思维链单独占 token，
# 实测可占输出的 90% 以上。本客户端默认发 thinking={"type":"disabled"} 关掉它，
# 需要推理质量的调用点显式传 thinking=True。
# 若所用端点不认识该参数并返回 400，把下面这行设为 0。
LLM_SEND_THINKING_PARAM=1

# ---- 嵌入模型（向量检索用）----
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ---- 服务 ----
FLASK_HOST=127.0.0.1
FLASK_PORT=5001

# ---- 仿真参数（控制成本的三个旋钮）----
OASIS_DEFAULT_MAX_ROUNDS=10
OASIS_MAX_AGENTS=30
