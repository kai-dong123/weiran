# 「未然」运行配置模板
#
# 用法：复制为 .env 并填入真实值。
#   cp .env.example .env
#
# ⚠️ .env 已在 .gitignore 中，**绝不入库**。
#    提交前自检：git status 里不应出现 .env。

# ---- 对话模型（OpenAI 兼容端点）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-v4-flash

# 推理开关。部分模型（如 DeepSeek 系）默认开启推理，思维链单独占 token，
# 实测可占输出的 90% 以上。本客户端默认发 thinking={"type":"disabled"} 关掉它，
# 需要推理质量的调用点显式传 thinking=True。
# 若所用端点不认识该参数并返回 400，把下面这行设为 0。
LLM_SEND_THINKING_PARAM=1

# ---- 嵌入模型（向量检索用）----
# **当前未启用**：向量列与检索函数已就位，但没有调用嵌入服务的客户端。
# 语料仅 33 个 chunk 的规模下混合检索没有可测量的收益，因此只保留通路不接线。
# 启用前请先确认服务商与许可证，并补进《开源及第三方资源使用清单》。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# ---- 仿真规模（控制成本的两个旋钮）----
# 这两个值此前是**死的** —— 写在这里但没有任何消费方，设了不生效也不报错。
# 现在由 simulate.py 的 --rounds / --agents 默认值消费；命令行显式传参优先。
#
# 成本量级：3 agent × 3 轮 ≈ 数十次调用。调用次数随 agent 数与轮数成乘积增长，
# 而每轮的 prompt 还因上下文累积继续变长（实测每轮约 1.9 倍），
# 所以总成本比「轮数 × agent 数」增长得更快。调大之前先看 进度.md 的实测记录。
OASIS_DEFAULT_MAX_ROUNDS=10
OASIS_MAX_AGENTS=30

# ---- 展示层监听地址（可选）----
# 只有 `python -m weiran.viewer` 起服务时用到；`--check` 与其它入口都不读这两行。
#
# FLASK_HOST **只接受回环**（127.0.0.1 / localhost / ::1）。填别的值会直接
# 报错停下，不会静默忽略 —— 展示层没有任何鉴权，绑到 0.0.0.0 会把「本地
# 查看工具」变成对局域网开放的只读服务。要给别人看，让对方在本机跑同一条
# 命令，而不是把这一层暴露出去。
# 不装 flask 也能用：不起服务时直接看 data/simulation/ 下的 brief.md 与
# gold_check.md，页面与那两份文字读的是同一批数。
FLASK_HOST=127.0.0.1
FLASK_PORT=8000
