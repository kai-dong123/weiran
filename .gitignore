# ---- 环境与密钥（绝不入库）----
.env
.env.*
!.env.example
*.key
*.pem

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# ---- Node ----
node_modules/
dist/
.vite/

# ---- 运行时产物（可重建，不入库）----
data/runs/*
# 例外：三支跨 seed 稳定性臂的**产出与清单**要入库。它们是技术报告里
# 「稳定性」那一组读数的全部输入，不入库那组读数就成了「只有我们算得出来」
# 的数 —— 而本作品把「可复核」当及格线。汇总器只读各臂的 `arm.json` 与
# `twitter_rounds.json`，所以各臂自己复制的底本输入（画像 / 知情映射 /
# 归类缓存）与 OASIS 的 .db 仍然不入库。
!data/runs/seeds/
data/runs/seeds/*/twitter_profiles.csv
data/runs/seeds/*/actor_knowledge.json
data/runs/seeds/*/stance_cache.json
data/*.db
*.log

# 上面那条 `data/*.db` 只匹配直接子项，`data/simulation/` 下还有 OASIS 自己
# 建的库（twitter_simulation.db / tw_diag.db），必须单独覆盖，否则一提交就是
# 好几十万行的二进制噪音。
data/**/*.db

# SQLite 的 WAL / SHM 是两个**边车文件**，后缀是 `.db-wal` / `.db-shm`，
# 上面那条 `*.db` 匹配不到它们。库正常关闭时它们会被自动删掉 —— 也就是说
# 它们不属于产物，只是一次连接留下的现场。实测漏掉这一条时，`git add -A`
# 会把两个二进制文件一起扫进去。
data/**/*.db-wal
data/**/*.db-shm

# ---- 缓存（可重建，不入库）----
# 这两个是 LLM 调用的落盘缓存，删除后重跑会再花钱，但内容完全可重建。
# 与「直接输入」的区别：删掉 twitter_profiles.csv 或 actor_knowledge.json，
# 第二步仿真就跑不起来；删掉缓存只是变慢。
data/simulation/*_cache.json

# ---- 但固定样本必须入库（可复现性的前提）----
!benchmark/fixtures/
!benchmark/fixtures/**

# ---- 编辑器 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
